# ==============================================================================
# OSS B2B - Configuration des Variables d'Environnement
# ==============================================================================

# Port d'écoute du serveur HTTP
PORT=5000

# Environnement (development | production | test)
NODE_ENV=development

# Clé secrète pour la signature des jetons JWT (Générer une chaîne aléatoire de 64+ car.)
JWT_SECRET=oss_b2b_super_secret_jwt_key_change_in_production_2026_central_africa
JWT_EXPIRES_IN=7d

# Origines CORS autorisées (séparées par une virgule en production)
CORS_ORIGIN=http://localhost:5000,http://127.0.0.1:5000,https://ossb2b.com

# Chemin vers la base de données SQLite
DATABASE_PATH=data/ossb2b.db

# Configuration d'agrégation externe (identifiants pour modules futurs)
# AIRTEL_MONEY_API_KEY=
# MTN_MOMO_API_KEY=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
